# Enhanced-radiative NC Delta(1232) sample: the production BNB overlay
# generator (volDetEnclosure, fiducial mbox, BNB simple_flux, 5e12 POT/spill,
# overlay RootInput source) restricted to GENIE's RES-NC process.
#
# NB: keep this file pure ASCII -- the FHiCL parser rejects non-ASCII bytes,
# even in comments.
#
# The Delta -> N gamma enhancement itself is NOT in this file: GENIE R-3_04_02
# has no fcl or XML knob for resonance branching ratios. The job must export
# GENIE_PDG_TABLE pointing at the patched table (delta_br.py table), which
# ncdeltarad_genie_env.sh does as the stage's larbatch <initsource>.
#
# "NCRES" is GENIE's global list (EventGeneratorListAssembler.xml); the tune
# (${GENIE_XSEC_TUNE}, AR23_20i) still supplies the RES-NC model. POTSummary
# stays per generated spill, so the sample is normalised by its own POT.

#include "simulation_genie_icarus_bnb_overlays_volDetEnclosure_fiducial.fcl"

physics.producers.generator.EventGeneratorList: "NCRES"

# Max path lengths: flux-ray scan (10000 BNB rays) with safety factor 2.0, and
# write maxpathlength.xml to the job directory.
# Why: GENIEHelper forces a single global probability scale (GMCJDriver::
# ForceSingleProbScale), built from max{xsec(E)} x max path length per
# material. With the Default list the total xsec keeps rising to the top of the
# BNB flux, which leaves a large margin at typical energies; the RES-NC xsec
# saturates, so an underestimated max path length from the "default" box scan
# overflows: GENIE exits with "Negative no interaction probability!" (seen at
# P = -40%). A larger safety factor only costs GENIE throws (unbiased; POT uses
# the same scale).
physics.producers.generator.GeomScan: "flux: 10000 2.0 1"

outputs.rootoutput.fileName: "simulation_genie_icarus_bnb_ncdeltarad_volDetEnclosure_%tc-%p.root"
